<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robot gripper urdf file -->
    <xacro:include filename="$(find robot_gripper)/urdf/robot_gripper_final.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robot gripper.ros2_control.xacro" />


    <xacro:robot_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
