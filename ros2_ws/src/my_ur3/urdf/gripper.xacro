<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="simple_gripper" params="parent">

    <!-- ========================================================= -->
    <!-- Gripper base -->
    <!-- ========================================================= -->

    <link name="gripper_base_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.08 0.04"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.08 0.04"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia
          ixx="0.001"
          ixy="0"
          ixz="0"
          iyy="0.001"
          iyz="0"
          izz="0.001"/>
      </inertial>

    </link>


    <!-- ========================================================= -->
    <!-- Mount gripper to UR3 flange -->
    <!-- ========================================================= -->

    <joint name="gripper_mount_joint" type="fixed">

      <parent link="${parent}"/>
      <child link="gripper_base_link"/>

      <origin
        xyz="0.02 0 0"
        rpy="0 1.5708 0"/>

    </joint>


    <!-- ========================================================= -->
    <!-- RIGHT FINGER - CONTROLLED -->
    <!-- ========================================================= -->

    <link name="right_finger_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.08"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia
          ixx="0.0001"
          ixy="0"
          ixz="0"
          iyy="0.0001"
          iyz="0"
          izz="0.0001"/>
      </inertial>

    </link>


    <joint name="right_finger_joint" type="prismatic">

      <parent link="gripper_base_link"/>
      <child link="right_finger_link"/>

  <!-- CLOSED position -->

      <origin
        xyz="0 -0.01 0.04"
        rpy="0 0 0"/>

  <!-- Positive joint value moves outward -->

      <axis xyz="0 -1 0"/>

      <limit
        lower="0.0"
        upper="0.04"
        effort="50"
        velocity="0.2"/>

    </joint>


    <!-- ========================================================= -->
    <!-- LEFT FINGER - MIMIC -->
    <!-- ========================================================= -->

    <link name="left_finger_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.08"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia
          ixx="0.0001"
          ixy="0"
          ixz="0"
          iyy="0.0001"
          iyz="0"
          izz="0.0001"/>
      </inertial>

    </link>


    <joint name="left_finger_joint" type="prismatic">

      <parent link="gripper_base_link"/>
      <child link="left_finger_link"/>

<!-- CLOSED position -->
      <origin
        xyz="0 0.01 0.04"
        rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

      <limit
        lower="0.0"
        upper="0.04"
        effort="50"
        velocity="0.2"/>

      <!-- Left finger follows right finger -->
      <mimic
        joint="right_finger_joint"
        multiplier="1.0"
        offset="0.0"/>

    </joint>

  </xacro:macro>

</robot>